{
    "production_system": {
        "name": "Professional Screen Capture & Computer Vision System",
        "version": "1.0.0",
        "purpose": "High-performance real-time screen capture and computer vision processing",
        "mode": "production_mode"
    },
    "vision_algorithms": {
        "selected_algorithm": "hsv",
        "hsv_tracking": {
            "enabled": true,
            "lower_bound": [140, 120, 180],
            "upper_bound": [160, 200, 255],
            "morphology_kernel_size": 3,
            "min_contour_area": 100
        },
        "yolo_detection": {
            "enabled": false,
            "model_path": "models/yolo.weights",
            "config_path": "models/yolo.cfg",
            "confidence_threshold": 0.5,
            "nms_threshold": 0.4
        },
        "yolo11_detection": {
            "enabled": true,
            "onnx_model_path": "models/yolo11n.onnx",
            "tensorrt_engine_path": "models/yolo11n.trt",
            "class_names_path": "models/coco_classes.txt",
            "confidence_threshold": 0.25,
            "nms_threshold": 0.45,
            "input_size": [640, 640],
            "max_detections": 100,
            "backend": "auto_detect",
            "tensorrt_settings": {
                "max_batch_size": 1,
                "max_workspace_size": 1073741824,
                "enable_fp16": true,
                "enable_int8": false,
                "enable_cuda_graph": true,
                "enable_tactic_sources": true,
                "dla_core": -1
            },
            "performance_settings": {
                "warmup_iterations": 10,
                "enable_profiling": false,
                "auto_engine_rebuild": true
            }
        }
    },
    "analytics": {
        "enabled": true,
        "max_history_size": 1000,
        "fps_calculation_window_sec": 5.0
    },
    "gui": {
        "show_performance_metrics": true,
        "ui_scale": 1.0,
        "show_metrics_overlay": true
    },
    "performance": {
        "target_fps": 60,
        "enable_multithreading": true,
        "max_processing_threads": 4,
        "frame_buffer_size": 5,
        "enable_gpu_acceleration": true,
        "gpu_settings": {
            "enable_tensorrt": true,
            "enable_cuda": true,
            "memory_pool_size": 512
        }
    }
}
